generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Inquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  project     String
  message     String
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
  salesStatus String   @default("NEW")
}

model Proposal {
  id          String   @id @default(cuid())
  inquiryId   String
  title       String
  description String
  amount      Float
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
